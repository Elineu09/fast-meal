# Fast Meal Backend - Environment Configuration

# Database Configuration
DB_HOST=localhost
DB_NAME=fast_meal
DB_USER=root
DB_PASSWORD=

# Server Configuration
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:4200

# Session Configuration
SESSION_TIMEOUT=3600

# API Configuration
API_VERSION=1.0
API_KEY_LENGTH=32

# Password Hashing
BCRYPT_COST=12

# File Upload
MAX_UPLOAD_SIZE=5242880
ALLOWED_UPLOAD_TYPES=pdf,csv,json

# Email Configuration (for password recovery - future)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@fastmeal.com

# QR Code API
QRCODE_API_URL=https://api.qrserver.com/v1/create-qr-code/
QRCODE_SIZE=300

# Logging
LOG_CHANNEL=single
LOG_PATH=../storage/logs/

# Security
CORS_ENABLED=true
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
